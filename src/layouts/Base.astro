---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SEO, { type Props as SEOProps } from '@/components/SEO.astro';
import { Font } from 'astro:assets';
import { site } from '@/data/site';
import { palette, tokensCss } from '@/styles/tokens';

type Props = SEOProps;
const seo = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-serif-jp" preload />
    <Font cssVariable="--font-plex-sans" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-plex-mono" />
    <style is:inline set:html={tokensCss}></style>
    <SEO {...seo} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — writing`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={palette.light.ash} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={palette.dark.ash} media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a href="#main" class="skip">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    background: var(--ash);
    padding: 0.5rem 0.75rem;
    z-index: 10;
  }
  main {
    min-height: 70dvh;
  }
</style>
