// Cloudflare Workers (static assets only). Deployed by Workers Builds: `npm run build` then `npx wrangler deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fudoryu-dev",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status
    "not_found_handling": "404-page",
    // Matches trailingSlash: 'always' in astro.config.ts
    "html_handling": "auto-trailing-slash",
  },
}
